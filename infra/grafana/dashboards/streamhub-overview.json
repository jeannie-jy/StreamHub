          "refId": "B"
        },
        {
          "expr": "max(streamhub_mq_deadletter_new)",
          "legendFormat": "dead letters",
          "refId": "C"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "streamhub-prometheus"
      },
      "fieldConfig": {
