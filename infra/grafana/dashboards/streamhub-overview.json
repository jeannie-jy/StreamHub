      "title": "RocketMQ consumer lag",
      "type": "timeseries",
      "targets": [
        {
          "expr": "max by (consumer_group) (streamhub_mq_consumer_lag)",
          "legendFormat": "{{consumer_group}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "streamhub-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "id": 6,
