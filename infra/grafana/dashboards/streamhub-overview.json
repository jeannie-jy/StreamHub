      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{job=\"streamhub\"}) by (area)",
          "legendFormat": "{{area}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "streamhub-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
