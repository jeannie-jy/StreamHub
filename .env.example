MYSQL_DATABASE=streamhub
MYSQL_USER=streamhub
MYSQL_PASSWORD=streamhub
MYSQL_ROOT_PASSWORD=streamhub-root
MINIO_ROOT_USER=streamhub
MINIO_ROOT_PASSWORD=streamhub-minio
ROCKETMQ_NAMESRV_ADDR=localhost:9876
ROCKETMQ_ACTIVITY_TIMEOUT_DELAY_LEVEL=3
NACOS_SERVER_ADDR=localhost:8848
NACOS_DISCOVERY_ENABLED=true
NACOS_CONFIG_ENABLED=true
NACOS_CONFIG_GROUP=STREAMHUB
REALTIME_GATEWAY_PORT=8090
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=streamhub-admin
WEB_PORT=8089
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=30d
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
AUTH_WS_TICKET_TTL=30s
MEDIA_RTMP_PUBLISH_BASE=rtmp://localhost:1935/live/
MEDIA_HTTP_FLV_PLAY_BASE=/live/
MEDIA_WEBRTC_PLAY_BASE=/rtc/v1/whep/?app=live&stream=
STREAMHUB_REALTIME_CHANNEL=live:room:events
STREAMHUB_NODE_ID=local
STREAMHUB_MAX_SESSIONS_PER_ROOM=10000
STREAMHUB_MAX_CHAT_EVENTS_PER_SECOND=1000
STREAMHUB_RECONCILIATION_ENABLED=true
STREAMHUB_RECONCILIATION_FIXED_DELAY_MS=60000
STREAMHUB_RECONCILIATION_PENDING_AGE_MS=30000
STREAMHUB_RECONCILIATION_BATCH_SIZE=100
STREAMHUB_RECONCILIATION_LOCK_KEY=streamhub:lock:reconciliation
